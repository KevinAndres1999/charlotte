rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir lectura/escritura en pendingStudents para registro público
    match /pendingStudents/{document} {
      allow read, write: if true;
    }

    // Permitir lectura/escritura en users para autenticación
    match /users/{document} {
      allow read, write: if request.auth != null || true; // Permitir acceso temporal para debugging
    }

    // Permitir lectura/escritura en contenido para usuarios autenticados (admin)
    match /content/{document} {
      allow read, write: if true;
    }

    match /classes/{document} {
      allow read, write: if true;
    }

    match /activities/{document} {
      allow read, write: if true;
    }

    match /materials/{document} {
      allow read, write: if true;
    }

    match /cuestionarios/{document} {
      allow read, write: if true;
    }

    match /evaluaciones/{document} {
      allow read, write: if true;
    }

    // Nuevas colecciones para recursos premium
    match /fotos/{document} {
      allow read, write: if true;
    }

    match /recursos/{document} {
      allow read, write: if true;
    }

    match /contactos/{document} {
      allow read, write: if true;
    }
  }

  // Allow all for any other documents
  match /{document=**} {
    allow read, write: if true;
  }
}