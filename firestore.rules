rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // USUARIOS
    // Lectura pública temporal: necesaria para la búsqueda por email durante el login
    // (antes de que Firebase Auth esté activo). Restringir a isAuthenticated() una vez
    // que todos los usuarios legados hayan sido migrados a Firebase Auth.
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // CONFIG - Solo usuarios autenticados pueden leer (protege API keys como OpenRouter)
    match /config/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // CONTENIDO
    match /content/{document} { allow read, write: if isAuthenticated(); }

    // CLASES
    match /classes/{document} { allow read, write: if isAuthenticated(); }
    match /class_chunks/{document} { allow read, write: if isAuthenticated(); }

    // ACTIVIDADES
    match /activities/{document} { allow read, write: if isAuthenticated(); }
    match /actividades_interactivas/{document} { allow read, write: if isAuthenticated(); }

    // MATERIALES
    match /materials/{document} { allow read, write: if isAuthenticated(); }

    // EVALUACIONES Y CUESTIONARIOS
    match /cuestionarios/{document} { allow read, write: if isAuthenticated(); }
    match /evaluaciones/{document} { allow read, write: if isAuthenticated(); }
    match /respuestasEvaluaciones/{document} { allow read, write: if isAuthenticated(); }
    match /reintentosEvaluaciones/{document} { allow read, write: if isAuthenticated(); }
    match /resultados_evaluaciones/{document} { allow read, write: if isAuthenticated(); }
    match /respuestasCuestionarios/{document} { allow read, write: if isAuthenticated(); }
    match /respuestas/{document} { allow read, write: if isAuthenticated(); }

    // ENTREGAS Y CALIFICACIONES
    match /entregas/{document} { allow read, write: if isAuthenticated(); }
    match /entregas_interactivas/{document} { allow read, write: if isAuthenticated(); }
    match /calificaciones_modulos/{document} { allow read, write: if isAuthenticated(); }
    match /calificaciones_practicas/{document} { allow read, write: if isAuthenticated(); }

    // FOROS
    match /foros/{document} { allow read, write: if isAuthenticated(); }
    match /respuestasForos/{document} { allow read, write: if isAuthenticated(); }

    // CONFIGURACIÓN DE LA APP
    match /configuracion/{document} { allow read, write: if isAuthenticated(); }

    // IA
    match /ai_analysis/{document} { allow read, write: if isAuthenticated(); }

    // RECURSOS Y PROYECTOS
    match /fotos/{document} { allow read, write: if isAuthenticated(); }
    match /recursos/{document} { allow read, write: if isAuthenticated(); }
    match /projects/{document} { allow read, write: if isAuthenticated(); }
    match /proyectos/{document} { allow read, write: if isAuthenticated(); }

    // ESTUDIANTES
    match /approvedStudents/{document} { allow read, write: if isAuthenticated(); }
    match /pendingStudents/{document} { allow read, write: if isAuthenticated(); }

    // CONTACTOS
    match /contactos/{document} { allow read, write: if isAuthenticated(); }

    // COMENTARIOS EN CLASES
    match /comentarios_clases/{claseId}/items/{document} { 
      allow read, write: if isAuthenticated(); 
    }

    // NOTIFICACIONES
    match /notificaciones/{userId}/items/{document} { 
      allow read, write: if isAuthenticated() && request.auth.uid == userId; 
    }

    // BORRADORES
    match /borradores/{userId}/actividades/{document} { 
      allow read, write: if isAuthenticated() && request.auth.uid == userId; 
    }

    // PREFERENCIAS Y BOOKMARKS
    match /usuarios/{userId}/preferencias/{document} { 
      allow read, write: if isAuthenticated() && request.auth.uid == userId; 
    }

    // ASISTENCIAS Y PAGOS
    // Estudiantes pueden leer sus propias asistencias y pagos
    // Admins pueden escribir y leer todo
    match /asistencias/{document} { 
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.rol == 'admin';
    }

    match /pagos/{document} { 
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.rol == 'admin';
    }
  }
}
