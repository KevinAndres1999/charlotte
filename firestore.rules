rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir que un usuario autenticado cree su propio perfil en users/{uid}
    match /users/{userId} {
      // Solo el usuario con el mismo UID puede crear su documento
      allow create: if request.auth != null && request.auth.uid == userId;

      // Lectura: el propio usuario, o cualquiera si el perfil está aprobado
      allow read: if request.auth != null && (request.auth.uid == userId || resource.data.status == 'approved');

      // Actualizar / borrar: solo el propio usuario
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Colección de materiales - lectura/escritura solo para admin/teacher
    match /materiales/{doc} {
      allow read: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','teacher']);
      allow write: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','teacher']);
    }

    // Colección de solicitudes pendientes
    match /pendingStudents/{doc} {
      // Crear: cualquier usuario autenticado puede crear su propia solicitud (email debe coincidir)
      allow create: if request.auth != null && request.resource.data.email == request.auth.token.email;
      // Leer / borrar: solo admin o teacher
      allow read, delete: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','teacher']);
      // Actualizar: reservado a admin/teacher
      allow update: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','teacher']);
    }

    // Colección de usuarios aprobados gestionada por admins
    match /approvedStudents/{doc} {
      allow read, write: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','teacher']);
    }

    // Permisos por defecto: denegar
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
