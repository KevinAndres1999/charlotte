rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Permitir que un usuario autenticado cree su propio perfil en users/{uid}
    match /users/{userId} {
      // Solo el usuario con el mismo UID puede crear su documento
      allow create: if request.auth != null && request.auth.uid == userId;

      // Lectura: el propio usuario, o cualquiera si el perfil está aprobado
      allow read: if request.auth != null && (request.auth.uid == userId || resource.data.status == 'approved');

      // Actualizar / borrar: solo el propio usuario
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Colecciones administradas por backend/admins
    match /approvedStudents/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /pendingStudents/{doc} {
      // Permitir lectura solo a usuarios autenticados (panel admin en cliente)
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Denegar por defecto para el resto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
