rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función helper para verificar autenticación
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función helper para verificar rol de admin
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }
    
    // USUARIOS - Todo público
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // CONTENIDO - Todo público
    match /content/{document} {
      allow read, write: if true;
    }

    // CLASES
    match /classes/{document} {
      allow read, write: if true;
    }
    
    // CHUNKS DE CLASES
    match /class_chunks/{document} {
      allow read, write: if true;
    }

    // ACTIVIDADES
    match /activities/{document} {
      allow read, write: if true;
    }

    // MATERIALES
    match /materials/{document} {
      allow read, write: if true;
    }

    // CUESTIONARIOS
    match /cuestionarios/{document} {
      allow read, write: if true;
    }

    // EVALUACIONES
    match /evaluaciones/{document} {
      allow read, write: if true;
    }
    
    // RESPUESTAS DE EVALUACIONES
    match /respuestasEvaluaciones/{document} {
      allow read, write: if true;
    }
    
    // REINTENTOS DE EVALUACIONES
    match /reintentosEvaluaciones/{document} {
      allow read, write: if true;
    }
    
    // ENTREGAS
    match /entregas/{document} {
      allow read, write: if true;
    }
    
    // RESPUESTAS DE CUESTIONARIOS
    match /respuestasCuestionarios/{document} {
      allow read, write: if true;
    }
    
    // RESPUESTAS (otra colección)
    match /respuestas/{document} {
      allow read, write: if true;
    }
    
    // RESPUESTAS DE EVALUACIONES
    match /respuestasEvaluaciones/{document} {
      allow read, write: if true;
    }
    
    // FOROS
    match /foros/{document} {
      allow read, write: if true;
    }
    
    // RESPUESTAS EN FOROS
    match /respuestasForos/{document} {
      allow read, write: if true;
    }
    
    // CALIFICACIONES
    match /calificaciones_modulos/{document} {
      allow read, write: if true;
    }
    
    // RESULTADOS DE EVALUACIONES
    match /resultados_evaluaciones/{document} {
      allow read, write: if true;
    }
    
    // CALIFICACIONES DE PRÁCTICAS
    match /calificaciones_practicas/{document} {
      allow read, write: if true;
    }
    
    // ACTIVIDADES INTERACTIVAS
    match /actividades_interactivas/{document} {
      allow read, write: if true;
    }
    
    // CONFIGURACIÓN
    match /configuracion/{document} {
      allow read, write: if true;
    }
    
    // CONFIG - API keys: lectura pública
    match /config/{document} {
      allow read: if true;
      allow write: if true;
    }
    
    // AI ANALYSIS
    match /ai_analysis/{document} {
      allow read, write: if true;
    }
    
    // FOTOS
    match /fotos/{document} {
      allow read, write: if true;
    }
    
    // RECURSOS
    match /recursos/{document} {
      allow read, write: if true;
    }
    
    // PROYECTOS
    match /projects/{document} {
      allow read, write: if true;
    }
    
    match /proyectos/{document} {
      allow read, write: if true;
    }
    
    // APROBADOS
    match /approvedStudents/{document} {
      allow read, write: if true;
    }
    
    // PENDIENTES
    match /pendingStudents/{document} {
      allow read, write: if true;
    }
    
    // CONTACTOS
    match /contactos/{document} {
      allow read, write: if true;
    }
  }
}
