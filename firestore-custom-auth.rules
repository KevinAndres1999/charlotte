rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions para el sistema de autenticación personalizado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'admin@admin.local';
    }
    
    function isStudent() {
      return request.auth != null && 
             request.auth.token.email == 'estudiante@ejemplo.edu';
    }
    
    function isOwner(userId) {
      return request.auth != null && 
             request.auth.uid == userId;
    }
    
    // Para el sistema de login personalizado, permitir acceso básico
    // pero con algunas restricciones de seguridad
    
    // Users collection - acceso controlado
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if false; // Creación manual
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Registro público de estudiantes pendientes
    match /pendingStudents/{document} {
      allow read: if isAdmin();
      allow create: if true; // Registro público
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Contenido educativo - acceso para usuarios autenticados
    match /classes/{document} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Chunks de clases
    match /class_chunks/{document} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Actividades educativas
    match /activities/{document} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Materiales educativos
    match /materials/{document} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Cuestionarios
    match /cuestionarios/{document} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Evaluaciones
    match /evaluaciones/{document} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Entregas de estudiantes
    match /entregas/{document} {
      allow read: if isOwner(resource.data.userId) || isAdmin() || isStudent();
      allow create: if isStudent();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Respuestas a cuestionarios
    match /respuestasCuestionarios/{document} {
      allow read: if isOwner(resource.data.userId) || isAdmin() || isStudent();
      allow create: if isStudent();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Respuestas a evaluaciones
    match /respuestasEvaluaciones/{document} {
      allow read: if isOwner(resource.data.userId) || isAdmin() || isStudent();
      allow create: if isStudent();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Foros
    match /foros/{document} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Respuestas de foros
    match /respuestasForos/{document} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Calificaciones de módulos - solo admins
    match /calificaciones_modulos/{document} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Configuración del sistema - solo admins
    match /configuracion/{document} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Fotos de perfil
    match /fotos/{document} {
      allow read: if isOwner(document) || isAdmin() || isStudent();
      allow create: if isAuthenticated();
      allow update: if isOwner(document) || isAdmin();
      allow delete: if isOwner(document) || isAdmin();
    }
    
    // Recursos generales
    match /recursos/{document} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Contactos - solo admins pueden ver, público puede crear
    match /contactos/{document} {
      allow read: if isAdmin();
      allow create: if true; // Formulario de contacto público
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
