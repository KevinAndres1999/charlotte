# Firebase Configuration
# Estas variables se configuran automáticamente en Netlify
# NO incluyas valores reales en este archivo

# Firebase Web App Configuration (Seguro de exponer)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ⚠️  NUNCA incluyas estas variables (son peligrosas):
# FIREBASE_CLIENT_EMAIL=...
# FIREBASE_PRIVATE_KEY=...

# Instrucciones de configuración:
# 1. Ve a https://console.firebase.google.com/
# 2. Selecciona tu proyecto
# 3. Ve a Configuración del proyecto > General > Tus apps
# 4. Copia la configuración del SDK web
# 5. Configura las variables en Netlify: netlify env:set VARIABLE_NAME value