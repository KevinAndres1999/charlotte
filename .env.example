# ==========================================
# Charlotte - Plataforma Educativa
# Variables de Entorno Necesarias
# ==========================================

# Copia este archivo a .env y completa los valores

# -----------------
# Servidor Express
# -----------------
PORT=3000
JWT_SECRET=tu-jwt-secret-aqui-muy-largo-y-seguro

# Contraseñas de desarrollo (solo para testing local)
DEV_STUDENT_PASSWORD=password123
DEV_ADMIN_PASSWORD=admin123

# -----------------
# Firebase (Web SDK - estas son públicas)
# -----------------
# Obtén estos valores de tu proyecto en Firebase Console
FIREBASE_API_KEY=tu-api-key
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto-id
FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
FIREBASE_MESSAGING_SENDER_ID=tu-sender-id
FIREBASE_APP_ID=tu-app-id

# -----------------
# Firebase Admin SDK (solo para server-side)
# -----------------
# NO exponer estas en el frontend
FIREBASE_ADMIN_PRIVATE_KEY=tu-private-key
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@tu-proyecto.iam.gserviceaccount.com
